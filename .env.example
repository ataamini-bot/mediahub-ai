# ==========================================
# Application
# ==========================================

APP_NAME=MediaHub AI
APP_ENV=development
DEBUG=true

SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=mediahub
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://mediahub:CHANGE_ME@postgres:5432/mediahub

# ==========================================
# Redis
# ==========================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

REDIS_URL=redis://redis:6379/0

# ==========================================
# Telegram
# ==========================================

TELEGRAM_BOT_TOKEN=CHANGE_ME
# Bootstrap-only identity used to create the first database-backed
# superadmin. Day-to-day admin access is managed from the bot panel.
TELEGRAM_SUPERADMIN_ID=

# Legacy bootstrap list kept temporarily for a safe migration from the
# current deployment. It will not be the authority after RBAC is active.
TELEGRAM_ADMIN_IDS=
BOT_BACKEND_API_KEY=CHANGE_ME

# Fernet key used to encrypt sensitive database-backed settings.
# The final installer generates this value automatically.
DATA_ENCRYPTION_KEY=CHANGE_ME
DISPLAY_TIMEZONE=Asia/Tehran

# ==========================================
# Storage
# ==========================================

STORAGE_TYPE=local

MEDIA_ROOT=/app/media
DOWNLOAD_ROOT=/app/downloads
TEMP_ROOT=/app/tmp

# ==========================================
# API
# ==========================================

API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# Frontend
# ==========================================

FRONTEND_URL=http://localhost:3000

# ==========================================
# Security
# ==========================================

CORS_ORIGINS=http://localhost:3000

# ==========================================
# AI
# ==========================================

AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==========================================
# Payments
# ==========================================

PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# Manual card-to-card subscription payments.
# Keep real values only in .env; never commit them.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
PAYMENT_BANK_NAME=

# Prices are in تومان (IRT).
PAYMENT_PRICE_1_MONTH=0
PAYMENT_PRICE_3_MONTHS=0
PAYMENT_PRICE_6_MONTHS=0
PAYMENT_PRICE_12_MONTHS=0

PAYMENT_RECEIPT_MAX_SIZE_MB=10

# ==========================================
# Application Limits
# ==========================================

FREE_DAILY_DOWNLOAD_LIMIT=3
FREE_MAX_FILE_SIZE_MB=300
MAX_CONCURRENT_DOWNLOADS=3
QUOTA_TIMEZONE=Asia/Tehran

# ============================================================
# Admin Notifications
# ============================================================

ADMIN_NOTIFICATIONS_ENABLED=false

# Telegram private supergroup/channel used for admin reports.
ADMIN_NOTIFICATIONS_CHAT_ID=

# Optional Telegram topic/message_thread_id values.
ADMIN_NOTIFICATIONS_MONITORING_TOPIC_ID=
ADMIN_NOTIFICATIONS_PAYMENTS_TOPIC_ID=
ADMIN_NOTIFICATIONS_BACKUPS_TOPIC_ID=
ADMIN_NOTIFICATIONS_SYSTEM_TOPIC_ID=

# Suppress identical Monitoring alerts for this many seconds.
ADMIN_NOTIFICATIONS_DEDUP_SECONDS=600

# Telegram Bot API endpoint.
ADMIN_NOTIFICATIONS_TELEGRAM_API_URL=https://api.telegram.org

# Suppress identical system lifecycle alerts for this many seconds.
ADMIN_NOTIFICATIONS_SYSTEM_DEDUP_SECONDS=120

# ============================================================
# Health Monitor
# ============================================================

# Health-check frequency.
HEALTH_MONITOR_INTERVAL_SECONDS=30

# Prevent false alerts while the stack is starting.
HEALTH_MONITOR_STARTUP_GRACE_SECONDS=15

# Internal Backend health endpoint.
HEALTH_MONITOR_BACKEND_URL=http://backend:8000/health

# Give Celery Worker time to reconnect after Redis recovers.
HEALTH_MONITOR_WORKER_REDIS_RECOVERY_GRACE_SECONDS=90
