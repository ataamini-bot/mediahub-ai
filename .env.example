# ==========================================
# Application
# ==========================================

APP_NAME=MediaHub AI
APP_ENV=development
DEBUG=true

SECRET_KEY=CHANGE_ME
JWT_SECRET_KEY=CHANGE_ME

# ==========================================
# PostgreSQL
# ==========================================

POSTGRES_DB=mediahub
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://mediahub:CHANGE_ME@postgres:5432/mediahub

# ==========================================
# Redis
# ==========================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

REDIS_URL=redis://redis:6379/0

# ==========================================
# Telegram
# ==========================================

TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_ADMIN_IDS=

# ==========================================
# Storage
# ==========================================

STORAGE_TYPE=local

MEDIA_ROOT=/app/media
DOWNLOAD_ROOT=/app/downloads
TEMP_ROOT=/app/tmp

# ==========================================
# API
# ==========================================

API_HOST=0.0.0.0
API_PORT=8000

# ==========================================
# Frontend
# ==========================================

FRONTEND_URL=http://localhost:3000

# ==========================================
# Security
# ==========================================

CORS_ORIGINS=http://localhost:3000

# ==========================================
# AI
# ==========================================

AI_PROVIDER=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ==========================================
# Payments
# ==========================================

PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# ==========================================
# Application Limits
# ==========================================

FREE_DAILY_DOWNLOAD_LIMIT=10
FREE_MAX_FILE_SIZE_MB=100
MAX_CONCURRENT_DOWNLOADS=3
